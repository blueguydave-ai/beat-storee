// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  country   String?
  avatar    String?
  role      UserRole @default(CUSTOMER)
  
  // Relations
  producerBeats Beat[] @relation("BeatProducer")
  orders    Order[]
  downloads Download[]
  reviews   Review[]
  favorites Favorite[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  PRODUCER
  ADMIN
  SUPER_ADMIN
}

// Beat model
model Beat {
  id             String   @id @default(cuid())
  title          String
  description    String
  bpm            Int
  musicalKey     String   // e.g., "Cm", "D Major"
  genre          String
  mood           String
  duration       Int      // in seconds
  status         BeatStatus @default(ACTIVE)
  
  // File references
  artworkUrl     String
  previewUrl     String   // 30 second preview MP3
  waveformData   Json?    // Waveform visualization data
  
  // Metadata
  producerId     String
  producer       User     @relation("BeatProducer", fields: [producerId], references: [id])
  instrumentTags String[] // Array of instruments
  moodTags       String[] // Array of moods
  
  // Relations
  licenses       License[]
  orderItems     OrderItem[]
  reviews        Review[]
  favorites      Favorite[]
  downloads      Download[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([producerId])
  @@index([genre])
  @@index([bpm])
}

enum BeatStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED
}

// License model
model License {
  id                 String @id @default(cuid())
  beatId             String
  beat               Beat   @relation(fields: [beatId], references: [id], onDelete: Cascade)
  
  licenseType        LicenseType
  price              Float
  
  // Features
  audioFormats       String[]       // e.g., ["mp3", "wav"]
  includeMidi        Boolean @default(false)
  includeStems       Boolean @default(false)
  distributionLimit  Int?           // null = unlimited
  
  orderItems         OrderItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([beatId])
}

enum LicenseType {
  BASIC_LEASE
  PREMIUM_LEASE
  UNLIMITED_LEASE
  EXCLUSIVE
}

// Order model
model Order {
  id             String @id @default(cuid())
  orderNumber    String @unique
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items          OrderItem[]
  totalAmount    Float
  taxAmount      Float @default(0)
  discountAmount Float @default(0)
  
  // Customer info
  customerEmail  String
  customerName   String
  customerCountry String?
  
  // Payment
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  stripePaymentId String?
  paystackRef    String?
  
  // Shipping
  status         OrderStatus @default(PENDING)
  shippingStatus ShippingStatus?
  
  // Metadata
  notes          String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([orderNumber])
}

enum PaymentMethod {
  CARD
  PAYPAL
  MOBILE_MONEY
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ShippingStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
}

// OrderItem model
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  beatId    String
  beat      Beat   @relation(fields: [beatId], references: [id])
  
  licenseId String
  license   License @relation(fields: [licenseId], references: [id])
  
  quantity  Int
  price     Float // Price at time of purchase
  
  createdAt DateTime @default(now())
  
  @@index([orderId])
  @@index([beatId])
}

// Download model (secure token-based downloads)
model Download {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  beatId      String
  beat        Beat   @relation(fields: [beatId], references: [id])
  
  token       String @unique // Secure download token
  fileType    String // mp3, wav, midi, stems, etc
  filePath    String // Server file path
  
  expiresAt   DateTime
  downloadedAt DateTime?
  downloadCount Int @default(0)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([beatId])
  @@index([token])
}

// Review model
model Review {
  id      String @id @default(cuid())
  beatId  String
  beat    Beat   @relation(fields: [beatId], references: [id], onDelete: Cascade)
  
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating  Int    // 1-5 stars
  comment String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([beatId, userId]) // One review per user per beat
  @@index([beatId])
  @@index([userId])
}

// Favorite/Wishlist model
model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  beatId String
  beat   Beat   @relation(fields: [beatId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, beatId]) // Prevent duplicates
  @@index([userId])
  @@index([beatId])
}

// Coupon model
model Coupon {
  id          String @id @default(cuid())
  code        String @unique
  description String?
  
  type        CouponType // percentage or fixed
  value       Float  // 20 for 20%, 10 for $10
  maxUses     Int?   // null = unlimited
  usedCount   Int @default(0)
  
  minAmount   Float? // Minimum order amount
  maxDiscount Float? // Maximum discount amount
  
  isActive    Boolean @default(true)
  startDate   DateTime @default(now())
  expiresAt   DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// Email notification log
model EmailLog {
  id        String @id @default(cuid())
  to        String
  subject   String
  type      EmailType
  
  sentAt    DateTime?
  failedAt  DateTime?
  error     String?
  
  relatedOrderId String?
  relatedUserId  String?
  
  createdAt DateTime @default(now())
}

enum EmailType {
  ORDER_CONFIRMATION
  DOWNLOAD_LINK
  PAYMENT_RECEIPT
  PASSWORD_RESET
  WELCOME
  NEWSLETTER
  PROMO
  SUPPORT_RESPONSE
}

// Analytics model
model Analytics {
  id          String @id @default(cuid())
  date        DateTime @unique
  
  // Revenue
  totalRevenue Float
  totalSales   Int
  averageOrderValue Float
  
  // User metrics
  newUsers    Int
  activeUsers Int
  
  // Beat metrics
  beatsViewed Int
  beatsFavorited Int
  previewsPlayed Int
  
  // Top performers
  topBeatId   String?
  topProducerId String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([date])
}

